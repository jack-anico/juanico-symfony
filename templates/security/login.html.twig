{% extends 'base.html.twig' %}

{% block title %}Log in | Juanico Hardware{% endblock %}

{% block body %}
<div class="panel mx-auto max-w-md !p-8">
    <form method="post">
        <h1 class="!mb-2">Please sign in</h1>
        <p class="text-sm text-slate-500">New to Juanico? <a href="{{ path('app_register') }}">Create an account</a></p>

        {% if error %}
            <div class="form-errors" role="alert">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
        {% endif %}

        {% if app.user %}
            <p>You are logged in as {{ app.user.userIdentifier }}, <a href="{{ logout_path() }}">Logout</a></p>
        {% endif %}

        <div class="form-row">
            <label for="inputEmail">Email</label>
            <input type="email" value="{{ last_username }}" name="email" id="inputEmail" autocomplete="email" required autofocus>
        </div>
        <div class="form-row">
            <label for="inputPassword">Password</label>
            <input type="password" name="password" id="inputPassword" autocomplete="current-password" required>
        </div>
        <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">

        <div class="form-row">
            <label><input type="checkbox" name="_remember_me"> Remember me</label>
        </div>

        <button class="button-primary w-full" type="submit">Sign in</button>
    </form>
</div>
{% endblock %}
