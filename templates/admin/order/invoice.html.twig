{% extends 'admin/layout.html.twig' %}

{% block title %}Invoice {{ order.orderNumber }}{% endblock %}

{% block body %}
    <h1>Invoice {{ order.orderNumber }}</h1>

    <p>Juanico Hardware | {{ order.createdAt|date('F j, Y') }}</p>

    {% set address = order.shippingAddress %}
    <p>
        Bill to: {{ order.customer.fullName }}<br>
        Ship to: {{ address.recipient }}, {{ address.line1 }}, {{ address.city }}, {{ address.province }} {{ address.postalCode }}<br>
        Phone: {{ address.phone }}
    </p>

    {{ include('admin/order/invoice_lines.html.twig') }}

    {% if order.payment %}<p>Payment: {{ order.payment.method|upper }} ({{ order.payment.status }})</p>{% endif %}

    <div class="action-row print:hidden">
        <button class="button-primary" type="button" onclick="window.print()">Print invoice</button>
        <a href="{{ path('app_admin_order_show', {id: order.id}) }}">Back to order</a>
    </div>
{% endblock %}
