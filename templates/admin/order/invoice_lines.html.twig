<table>
    <thead><tr><th>Item</th><th>SKU</th><th>Qty</th><th>Unit price</th><th>Line total</th></tr></thead>
    <tbody>
        {% for item in order.items %}
            <tr>
                <td>{{ item.product.name }}</td>
                <td>{{ item.product.sku }}</td>
                <td>{{ item.quantity }}</td>
                <td>{{ (item.unitPrice)|peso }}</td>
                <td>{{ (item.lineTotal)|peso }}</td>
            </tr>
        {% endfor %}
    </tbody>
    <tfoot>
        <tr><th colspan="4">Subtotal</th><td>{{ (order.subtotal)|peso }}</td></tr>
        <tr><th colspan="4">Shipping</th><td>{{ (order.shippingFee)|peso }}</td></tr>
        <tr><th colspan="4">Discount</th><td>{{ (order.discount)|peso }}</td></tr>
        <tr><th colspan="4">Total</th><td>{{ (order.total)|peso }}</td></tr>
    </tfoot>
</table>
