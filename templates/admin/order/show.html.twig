{% extends 'admin/layout.html.twig' %}

{% block title %}Order {{ order.orderNumber }}{% endblock %}

{% block body %}
    <h1>Order {{ order.orderNumber }}</h1>

    <p>
        <a href="{{ path('app_admin_order_index') }}">Back to orders</a> |
        <a href="{{ path('app_admin_order_invoice', {id: order.id}) }}">Invoice</a>
        {% if order.payment %}| <a href="{{ path('app_admin_payment_show', {id: order.payment.id}) }}">Payment details</a>{% endif %}
    </p>

    <ul>
        <li>Status: {{ order.status|capitalize }}</li>
        <li>Customer: {{ order.customer.fullName }} ({{ order.customer.email }})</li>
        <li>Placed: {{ order.createdAt|date('Y-m-d H:i') }}</li>
        {% if order.payment %}<li>Payment: {{ order.payment.method|upper }}, {{ order.payment.status }}{% if order.payment.paidAt %} on {{ order.payment.paidAt|date('Y-m-d H:i') }}{% endif %}</li>{% endif %}
        <li>Shipping: {{ order.shippingMethod|capitalize }}</li>
        {% if order.deliveredAt %}<li>Delivered: {{ order.deliveredAt|date('Y-m-d H:i') }}</li>{% endif %}
        {% if order.cancelReason %}<li>Cancel reason: {{ order.cancelReason }}</li>{% endif %}
        {% if order.notes %}<li>Customer notes: {{ order.notes }}</li>{% endif %}
    </ul>

    {{ include('admin/order/invoice_lines.html.twig') }}

    <h2>Update order</h2>
    {{ form_start(form) }}
        {{ form_widget(form) }}
        <button>Save</button>
    {{ form_end(form) }}

    {% if can_cancel %}
        <h2>Cancel order</h2>
        <form method="post" action="{{ path('app_admin_order_cancel', {id: order.id}) }}">
            <input type="hidden" name="_token" value="{{ csrf_token('cancel' ~ order.id) }}">
            <label>Reason <textarea name="reason" required></textarea></label>
            <button>Cancel order</button>
        </form>
    {% endif %}

    <h2>Status history</h2>
    <div class="table-scroll"><table>
        <thead><tr><th>When</th><th>From</th><th>To</th><th>By</th><th>Note</th></tr></thead>
        <tbody>
            {% for row in history %}
                <tr>
                    <td>{{ row.createdAt|date('Y-m-d H:i:s') }}</td>
                    <td>{{ row.fromStatus }}</td>
                    <td>{{ row.toStatus }}</td>
                    <td>{{ row.changedBy ? row.changedBy.email }}</td>
                    <td>{{ row.note }}</td>
                </tr>
            {% endfor %}
        </tbody>
    </table></div>
{% endblock %}
