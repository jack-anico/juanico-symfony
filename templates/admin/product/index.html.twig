{% extends 'admin/layout.html.twig' %}

{% block title %}Product index{% endblock %}

{% block body %}
    <h1>Product index</h1>

    <div class="table-scroll"><table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Name</th>
                <th>Sku</th>
                <th>Slug</th>
                <th>Description</th>
                <th>Price</th>
                <th>CostPrice</th>
                <th>SalePrice</th>
                <th>Unit</th>
                <th>Stock</th>
                <th>LowStockThreshold</th>
                <th>Image</th>
                <th>Status</th>
                <th>IsFeatured</th>
                <th>Specifications</th>
                <th>CreatedAt</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for product in products %}
            <tr>
                <td>{{ product.id }}</td>
                <td>{{ product.name }}</td>
                <td>{{ product.sku }}</td>
                <td>{{ product.slug }}</td>
                <td>{{ product.description }}</td>
                <td>{{ product.price }}</td>
                <td>{{ product.costPrice }}</td>
                <td>{{ product.salePrice }}</td>
                <td>{{ product.unit }}</td>
                <td>{{ product.stock }}</td>
                <td>{{ product.lowStockThreshold }}</td>
                <td>{{ product.image }}</td>
                <td>{{ product.status }}</td>
                <td>{{ product.isFeatured ? 'Yes' : 'No' }}</td>
                <td>{{ product.specifications ? product.specifications|json_encode : '' }}</td>
                <td>{{ product.createdAt ? product.createdAt|date('Y-m-d H:i:s') : '' }}</td>
                <td>
                    <a href="{{ path('app_admin_product_show', {'id': product.id}) }}">show</a>
                    <a href="{{ path('app_admin_product_edit', {'id': product.id}) }}">Edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="17">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table></div>

    <a href="{{ path('app_admin_product_new') }}">Create new</a>

    {{ knp_pagination_render(products) }}
{% endblock %}
