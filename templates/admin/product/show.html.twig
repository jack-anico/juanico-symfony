{% extends 'base.html.twig' %}

{% block title %}Product{% endblock %}

{% block body %}
    <h1>Product</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ product.id }}</td>
            </tr>
            <tr>
                <th>Name</th>
                <td>{{ product.name }}</td>
            </tr>
            <tr>
                <th>Sku</th>
                <td>{{ product.sku }}</td>
            </tr>
            <tr>
                <th>Slug</th>
                <td>{{ product.slug }}</td>
            </tr>
            <tr>
                <th>Description</th>
                <td>{{ product.description }}</td>
            </tr>
            <tr>
                <th>Price</th>
                <td>{{ product.price }}</td>
            </tr>
            <tr>
                <th>CostPrice</th>
                <td>{{ product.costPrice }}</td>
            </tr>
            <tr>
                <th>SalePrice</th>
                <td>{{ product.salePrice }}</td>
            </tr>
            <tr>
                <th>Unit</th>
                <td>{{ product.unit }}</td>
            </tr>
            <tr>
                <th>Stock</th>
                <td>{{ product.stock }}</td>
            </tr>
            <tr>
                <th>LowStockThreshold</th>
                <td>{{ product.lowStockThreshold }}</td>
            </tr>
            <tr>
                <th>Image</th>
                <td>{% if product.image %}<img src="{{ asset('uploads/products/' ~ product.image) }}" alt="{{ product.name }}" width="200">{% endif %}</td>
            </tr>
            <tr>
                <th>Status</th>
                <td>{{ product.status }}</td>
            </tr>
            <tr>
                <th>IsFeatured</th>
                <td>{{ product.isFeatured ? 'Yes' : 'No' }}</td>
            </tr>
            <tr>
                <th>Specifications</th>
                <td>{{ product.specifications ? product.specifications|json_encode : '' }}</td>
            </tr>
            <tr>
                <th>CreatedAt</th>
                <td>{{ product.createdAt ? product.createdAt|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_admin_product_index') }}">back to list</a>

    <a href="{{ path('app_admin_product_edit', {'id': product.id}) }}">edit</a>

    <h2>Adjust stock</h2>
    {{ form_start(stock_form) }}
        {{ form_widget(stock_form) }}
        <button>Apply adjustment</button>
    {{ form_end(stock_form) }}

    {{ include('admin/product/_delete_form.html.twig') }}
{% endblock %}
