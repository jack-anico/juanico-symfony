{% extends 'base.html.twig' %}

{% block title %}DeliveryZone{% endblock %}

{% block body %}
    <h1>DeliveryZone</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ delivery_zone.id }}</td>
            </tr>
            <tr>
                <th>Name</th>
                <td>{{ delivery_zone.name }}</td>
            </tr>
            <tr>
                <th>Provinces</th>
                <td>{{ delivery_zone.provinces ? delivery_zone.provinces|json_encode : '' }}</td>
            </tr>
            <tr>
                <th>ShippingFee</th>
                <td>{{ delivery_zone.shippingFee }}</td>
            </tr>
            <tr>
                <th>IsActive</th>
                <td>{{ delivery_zone.isActive ? 'Yes' : 'No' }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_admin_delivery_zone_index') }}">back to list</a>

    <a href="{{ path('app_admin_delivery_zone_edit', {'id': delivery_zone.id}) }}">edit</a>

    {{ include('admin/delivery_zone/_delete_form.html.twig') }}
{% endblock %}
