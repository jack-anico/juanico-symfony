{% extends 'base.html.twig' %}

{% block title %}Inquiry{% endblock %}

{% block body %}
    <h1>Inquiry</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ inquiry.id }}</td>
            </tr>
            <tr>
                <th>Name</th>
                <td>{{ inquiry.name }}</td>
            </tr>
            <tr>
                <th>Email</th>
                <td>{{ inquiry.email }}</td>
            </tr>
            <tr>
                <th>Subject</th>
                <td>{{ inquiry.subject }}</td>
            </tr>
            <tr>
                <th>Message</th>
                <td>{{ inquiry.message }}</td>
            </tr>
            <tr>
                <th>Status</th>
                <td>{{ inquiry.status }}</td>
            </tr>
            <tr>
                <th>CreatedAt</th>
                <td>{{ inquiry.createdAt ? inquiry.createdAt|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_admin_inquiry_index') }}">back to list</a>

    <a href="{{ path('app_admin_inquiry_edit', {'id': inquiry.id}) }}">edit</a>

    {{ include('admin/inquiry/_delete_form.html.twig') }}
{% endblock %}
