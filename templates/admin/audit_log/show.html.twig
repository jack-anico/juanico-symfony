{% extends 'admin/layout.html.twig' %}

{% block title %}Audit Entry{% endblock %}

{% block body %}
    <h1>Audit Entry</h1>

    <p><a href="{{ path('app_admin_audit_log_index') }}">Back to audit log</a></p>

    <dl class="detail-list panel max-w-2xl">
        <div><dt>When</dt><dd>{{ audit_log.createdAt|date('Y-m-d H:i:s') }}</dd></div>
        <div><dt>Admin</dt><dd>{{ audit_log.admin.email }}</dd></div>
        <div><dt>Action</dt><dd>{{ audit_log.action }}</dd></div>
        <div><dt>Record</dt><dd>{{ audit_log.entityType }} #{{ audit_log.entityId }}</dd></div>
        <div><dt>Detail</dt><dd>{{ audit_log.detail ? audit_log.detail|json_encode : 'None' }}</dd></div>
    </dl>
{% endblock %}
