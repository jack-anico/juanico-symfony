{% extends 'admin/layout.html.twig' %}

{% block title %}Brand{% endblock %}

{% block body %}
    <h1>Brand</h1>

    <div class="table-scroll"><table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ brand.id }}</td>
            </tr>
            <tr>
                <th>Name</th>
                <td>{{ brand.name }}</td>
            </tr>
            <tr>
                <th>Logo</th>
                <td>{{ brand.logo }}</td>
            </tr>
            <tr>
                <th>IsActive</th>
                <td>{{ brand.isActive ? 'Yes' : 'No' }}</td>
            </tr>
        </tbody>
    </table></div>

    <a href="{{ path('app_admin_brand_index') }}">Back to list</a>

    <a href="{{ path('app_admin_brand_edit', {'id': brand.id}) }}">Edit</a>

    {{ include('admin/brand/_delete_form.html.twig') }}
{% endblock %}
