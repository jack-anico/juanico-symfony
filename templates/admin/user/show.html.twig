{% extends 'base.html.twig' %}

{% block title %}{{ user.fullName }}{% endblock %}

{% block body %}
    <h1>{{ user.fullName }}</h1>

    <p><a href="{{ path('app_admin_user_index') }}">Back to users</a></p>

    <ul>
        <li>Email: {{ user.email }}</li>
        <li>Phone: {{ user.phone }}</li>
        <li>Role: {{ 'ROLE_ADMIN' in user.roles ? 'Admin' : 'Customer' }}</li>
        <li>Verified: {{ user.isVerified ? 'Yes' : 'No' }}</li>
        <li>Active: {{ user.isActive ? 'Yes' : 'No' }}</li>
        <li>Joined: {{ user.createdAt|date('Y-m-d H:i') }}</li>
    </ul>

    <form method="post" action="{{ path('app_admin_user_toggle_active', {id: user.id}) }}">
        <input type="hidden" name="_token" value="{{ csrf_token('toggle' ~ user.id) }}">
        <button>{{ user.isActive ? 'Deactivate' : 'Activate' }}</button>
    </form>
{% endblock %}
