{% extends 'base.html.twig' %}

{% block title %}Catalog{% endblock %}

{% block body %}
    <h1>Catalog</h1>

    {{ form_start(form) }}
        {{ form_widget(form) }}
        <button>Apply filters</button>
    {{ form_end(form) }}

    <table>
        <thead><tr><th>Product</th><th>Category</th><th>Brand</th><th>Price</th><th>Availability</th></tr></thead>
        <tbody>
            {% for product in products %}
                <tr>
                    <td><a href="{{ path('app_product_show', {slug: product.slug}) }}">{{ product.name }}</a></td>
                    <td>{{ product.category.name }}</td>
                    <td>{{ product.brand ? product.brand.name }}</td>
                    <td>
                        {% if product.salePrice %}<s>PHP {{ product.price }}</s>{% endif %}
                        PHP {{ product.effectivePrice }} / {{ product.unit }}
                    </td>
                    <td>{{ product.stock > 0 ? 'In stock' : 'Out of stock' }}</td>
                </tr>
            {% else %}
                <tr><td colspan="5">No products match your search</td></tr>
            {% endfor %}
        </tbody>
    </table>

    {{ knp_pagination_render(products) }}
{% endblock %}
