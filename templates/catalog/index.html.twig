{% extends 'base.html.twig' %}

{% block title %}{{ deals ? 'Deals' : 'Catalog' }} | Juanico Hardware{% endblock %}

{% block body %}
    <p class="eyebrow">{{ deals ? 'On sale now' : 'Find your aisle' }}</p>
    <h1 class="mt-2">{{ deals ? 'Deals' : 'Catalog' }}</h1>

    <div class="grid gap-8 lg:grid-cols-[17rem_minmax(0,1fr)]">
        <aside class="panel h-fit" id="filters">
            {{ form_start(form) }}
                {{ form_widget(form) }}
                <button class="button-primary w-full">Apply filters</button>
            {{ form_end(form) }}
            <a class="mt-3 block text-center text-sm font-bold text-navy-700" href="{{ path('app_catalog') }}">Clear filters</a>
        </aside>

        <div>
            <p class="mb-4 text-sm text-slate-500">{{ products.totalItemCount }} {{ products.totalItemCount == 1 ? 'product' : 'products' }}</p>
            {% if products.totalItemCount and products|length %}
                <div class="grid grid-cols-2 gap-3 sm:gap-5 xl:grid-cols-3">
                    {% for product in products %}{{ include('_partials/product_card.html.twig') }}{% endfor %}
                </div>
            {% else %}
                <div class="empty-state">
                    <span class="flex justify-center text-slate-400">{{ include('_partials/icon.html.twig', {name: 'search', class: 'size-8'}) }}</span>
                    <h3>No tools found</h3>
                    <p class="text-sm text-slate-500">No products match your search. Try a product type or brand.</p>
                    <a class="font-bold text-navy-700" href="{{ path('app_catalog') }}">Clear search</a>
                </div>
            {% endif %}
            <div class="mt-8">{{ knp_pagination_render(products) }}</div>
        </div>
    </div>
{% endblock %}
