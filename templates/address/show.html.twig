{% extends 'base.html.twig' %}

{% block title %}{{ address.label }}{% endblock %}

{% block body %}
    <h1>{{ address.label }}</h1>

    <ul>
        <li>Recipient: {{ address.recipient }}</li>
        <li>Phone: {{ address.phone }}</li>
        <li>Address: {{ address.line1 }}, {{ address.city }}, {{ address.province }} {{ address.postalCode }}</li>
        <li>Default: {{ address.isDefault ? 'Yes' : 'No' }}</li>
    </ul>

    <a href="{{ path('app_address_index') }}">Back to my addresses</a> |
    <a href="{{ path('app_address_edit', {id: address.id}) }}">Edit</a>

    {{ include('address/_delete_form.html.twig') }}
{% endblock %}
