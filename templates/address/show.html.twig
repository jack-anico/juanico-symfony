{% extends 'base.html.twig' %}

{% block title %}{{ address.label }} | Juanico Hardware{% endblock %}

{% block body %}
    <h1>{{ address.label }}{% if address.isDefault %} <span class="badge badge-green align-middle">Default</span>{% endif %}</h1>

    <dl class="detail-list panel max-w-xl">
        <div><dt>Recipient</dt><dd>{{ address.recipient }}</dd></div>
        <div><dt>Phone</dt><dd>{{ address.phone }}</dd></div>
        <div><dt>Address</dt><dd>{{ address.line1 }}, {{ address.city }}, {{ address.province }} {{ address.postalCode }}</dd></div>
    </dl>

    <div class="action-row">
        <a class="button-secondary" href="{{ path('app_address_edit', {id: address.id}) }}">Edit</a>
        {{ include('address/_delete_form.html.twig') }}
        <a href="{{ path('app_address_index') }}">Back to my addresses</a>
    </div>
{% endblock %}
