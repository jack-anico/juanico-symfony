{% extends 'base.html.twig' %}

{% block title %}Address index{% endblock %}

{% block body %}
    <h1>Address index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Label</th>
                <th>Recipient</th>
                <th>Phone</th>
                <th>Line1</th>
                <th>City</th>
                <th>Province</th>
                <th>PostalCode</th>
                <th>IsDefault</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for address in addresses %}
            <tr>
                <td>{{ address.id }}</td>
                <td>{{ address.label }}</td>
                <td>{{ address.recipient }}</td>
                <td>{{ address.phone }}</td>
                <td>{{ address.line1 }}</td>
                <td>{{ address.city }}</td>
                <td>{{ address.province }}</td>
                <td>{{ address.postalCode }}</td>
                <td>{{ address.isDefault ? 'Yes' : 'No' }}</td>
                <td>
                    <a href="{{ path('app_address_show', {'id': address.id}) }}">show</a>
                    <a href="{{ path('app_address_edit', {'id': address.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="10">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_address_new') }}">Create new</a>
{% endblock %}
