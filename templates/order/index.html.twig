{% extends 'base.html.twig' %}

{% block title %}My Orders | Juanico Hardware{% endblock %}

{% block body %}
    <h1>My Orders</h1>

    <div class="no-scrollbar mb-5 flex gap-2 overflow-x-auto pb-2">
        {% set active = app.request.query.get('status') %}
        <a class="{{ active ? 'border border-slate-200 bg-white' : 'bg-navy-800 text-white' }} flex h-10 shrink-0 items-center rounded-lg px-4 text-sm font-bold" href="{{ path('app_order_index') }}">All</a>
        {% for status in statuses %}
            <a class="{{ active == status ? 'bg-navy-800 text-white' : 'border border-slate-200 bg-white' }} flex h-10 shrink-0 items-center rounded-lg px-4 text-sm font-bold" href="{{ path('app_order_index', {status: status}) }}">{{ status|capitalize }}</a>
        {% endfor %}
    </div>

    <div class="table-scroll">
        <table>
            <thead><tr><th>Order</th><th>Date</th><th>Status</th><th>Total</th></tr></thead>
            <tbody>
                {% for order in orders %}
                    <tr>
                        <td><a href="{{ path('app_order_show', {id: order.id}) }}">{{ order.orderNumber }}</a></td>
                        <td>{{ order.createdAt|date('M j, Y g:i A') }}</td>
                        <td><span class="badge {{ order.status == 'delivered' ? 'badge-green' : (order.status == 'cancelled' ? 'badge-red' : '') }}">{{ order.status|capitalize }}</span></td>
                        <td class="font-bold tabular-nums">{{ order.total|peso }}</td>
                    </tr>
                {% else %}
                    <tr><td colspan="4">No orders found</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    {{ knp_pagination_render(orders) }}
{% endblock %}
