{% extends 'base.html.twig' %}

{% block title %}{{ product.name }} | Juanico Hardware{% endblock %}

{% block body %}
    <nav aria-label="Breadcrumb" class="mb-6 text-sm text-slate-500">
        <a href="{{ path('app_catalog') }}">Catalog</a> /
        <a href="{{ path('app_catalog', {category: product.category.id}) }}">{{ product.category.name }}</a>
    </nav>

    <div class="grid gap-8 lg:grid-cols-2 lg:gap-12">
        <div class="aspect-square overflow-hidden rounded-2xl border border-slate-200 bg-white">
            {% if product.image %}
                <img src="{{ asset('uploads/products/' ~ product.image) }}" alt="{{ product.name }}" class="h-full w-full object-contain p-6" width="800" height="800">
            {% else %}
                <span class="grid h-full place-items-center bg-navy-50 text-navy-200">{{ include('_partials/icon.html.twig', {name: 'tools', class: 'size-24'}) }}</span>
            {% endif %}
        </div>

        <div>
            {% if product.brand %}<p class="eyebrow">{{ product.brand.name }}</p>{% endif %}
            <h1 class="mt-2">{{ product.name }}</h1>

            <p class="text-sm text-slate-500">
                <span class="text-amber-500" aria-hidden="true">★</span>
                {{ average_rating is null ? 'No ratings yet' : average_rating|number_format(1) ~ ' / 5' }}
                <span class="mx-2">·</span> SKU: {{ product.sku }}
            </p>

            <p class="mt-5 text-3xl font-black tabular-nums text-navy-950">
                {{ product.effectivePrice|peso }}
                <span class="text-sm font-medium text-slate-500">/ {{ product.unit }}</span>
            </p>
            {% if product.salePrice %}<p class="text-sm text-slate-400"><s>{{ product.price|peso }}</s></p>{% endif %}

            <p class="mt-3">
                {% if product.stock <= 0 %}
                    <span class="badge badge-red">Out of stock</span>
                {% elseif product.stock <= product.lowStockThreshold %}
                    <span class="badge badge-amber">Only {{ product.stock }} in stock</span>
                {% else %}
                    <span class="badge badge-green">{{ product.stock }} in stock</span>
                {% endif %}
            </p>

            <div class="mt-6 flex flex-wrap items-end gap-3">
                {% if app.user %}
                    {% if product.stock > 0 %}
                        <form method="post" action="{{ path('app_cart_add', {id: product.id}) }}" class="flex items-end gap-3">
                            <input type="hidden" name="_token" value="{{ csrf_token('cart') }}">
                            <label class="!mb-0">Quantity <input class="mt-1.5 !w-24" type="number" name="quantity" value="1" min="1" max="{{ product.stock }}"></label>
                            <button class="button-primary">{{ include('_partials/icon.html.twig', {name: 'cart'}) }} Add to cart</button>
                        </form>
                    {% endif %}
                    {% if not in_wishlist %}
                        <form method="post" action="{{ path('app_wishlist_add', {id: product.id}) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('wishlist') }}">
                            <button class="button-secondary">{{ include('_partials/icon.html.twig', {name: 'heart'}) }} Add to wishlist</button>
                        </form>
                    {% endif %}
                {% else %}
                    <a class="button-primary" href="{{ path('app_login') }}">Log in to buy this product</a>
                {% endif %}
            </div>

            <div class="mt-8 border-t border-slate-200 pt-6">{{ product.description|nl2br }}</div>

            {% if product.specifications %}
                <h2>Specifications</h2>
                <table>
                    <tbody>
                        {% for name, value in product.specifications %}
                            <tr><th class="w-1/3">{{ name|capitalize }}</th><td>{{ value is iterable ? value|json_encode : value }}</td></tr>
                        {% endfor %}
                    </tbody>
                </table>
            {% endif %}
        </div>
    </div>

    <section class="mt-14 grid gap-8 lg:grid-cols-2">
        <div>
            <h2 class="!mt-0">Reviews</h2>
            {% for review in reviews %}
                <div class="panel mb-3">
                    <p class="!mb-1 font-bold text-navy-950"><span class="text-amber-500" aria-label="{{ review.rating }} out of 5">{% for star in 1..review.rating %}★{% endfor %}</span> {{ review.rating }}/5 by {{ review.author.fullName }}</p>
                    <p class="!mb-0">{{ review.comment }}</p>
                </div>
            {% else %}
                <p>No reviews yet.</p>
            {% endfor %}
        </div>
        {% if review_form %}
            <div class="panel h-fit">
                <h3 class="!mt-0">Write a review</h3>
                {{ form_start(review_form) }}
                    {{ form_widget(review_form) }}
                    <button class="button-primary">Submit review</button>
                {{ form_end(review_form) }}
            </div>
        {% endif %}
    </section>

    {% if related %}
        <section class="mt-14">
            <h2>Related products</h2>
            <div class="grid grid-cols-2 gap-3 sm:gap-5 lg:grid-cols-4">
                {% for product in related %}{{ include('_partials/product_card.html.twig') }}{% endfor %}
            </div>
        </section>
    {% endif %}
{% endblock %}
