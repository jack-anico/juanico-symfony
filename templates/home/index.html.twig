{% extends 'base.html.twig' %}

{% block title %}Juanico Hardware{% endblock %}

{% block body %}
    <h1>Juanico Hardware</h1>
    <p>Carpentry tools and building materials.</p>

    <h2>Shop by category</h2>
    <ul>
        {% for category in categories %}
            <li><a href="{{ path('app_catalog', {category: category.id}) }}">{{ category.name }}</a></li>
        {% else %}
            <li>Categories are coming soon</li>
        {% endfor %}
    </ul>

    <h2>Featured</h2>
    <ul>
        {% for product in featured %}
            <li><a href="{{ path('app_product_show', {slug: product.slug}) }}">{{ product.name }}</a>: PHP {{ product.effectivePrice }}</li>
        {% else %}
            <li>No featured products yet</li>
        {% endfor %}
    </ul>

    <h2>On sale</h2>
    <ul>
        {% for product in on_sale %}
            <li><a href="{{ path('app_product_show', {slug: product.slug}) }}">{{ product.name }}</a>: <s>PHP {{ product.price }}</s> PHP {{ product.salePrice }}</li>
        {% else %}
            <li>No sales right now</li>
        {% endfor %}
    </ul>
{% endblock %}
