{% extends 'base.html.twig' %}

{% block title %}Checkout{% endblock %}

{% block body %}
    <h1>Checkout</h1>

    <ul>
        {% for item in items %}
            <li>{{ item.quantity }} x {{ item.product.name }}: PHP {{ item.lineTotal }}</li>
        {% endfor %}
    </ul>

    {{ form_start(form) }}
        {{ form_errors(form) }}
        {{ form_widget(form) }}
        <button>Place order</button>
    {{ form_end(form) }}

    <p><a href="{{ path('app_address_new') }}">Add a new address</a></p>
{% endblock %}
