{% extends 'base.html.twig' %}

{% block title %}Checkout | Juanico Hardware{% endblock %}

{% block body %}
    <h1>Checkout</h1>

    <div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_22rem]" data-controller="checkout" data-checkout-url-value="{{ path('app_checkout_preview') }}" data-action="change->checkout#refresh">
        <div class="panel">
            {{ form_start(form) }}
                {{ form_errors(form) }}
                {{ form_widget(form) }}
                <button class="button-primary w-full sm:w-auto">Place order</button>
            {{ form_end(form) }}
            <p class="!mb-0 mt-4 text-sm"><a href="{{ path('app_address_new') }}">Add a new address</a></p>
        </div>

        <aside class="panel h-fit lg:sticky lg:top-24">
            <h2 class="!mt-0">Your items</h2>
            <ul class="space-y-3 text-sm">
                {% for item in items %}
                    <li class="flex justify-between gap-4"><span>{{ item.quantity }} x {{ item.product.name }}</span><span class="font-bold tabular-nums text-navy-950">{{ item.lineTotal|peso }}</span></li>
                {% endfor %}
            </ul>
            <dl class="mt-4 space-y-2 border-t border-slate-100 pt-4 text-sm">
                <div class="flex justify-between"><dt>Subtotal</dt><dd class="tabular-nums" data-checkout-target="subtotal">-</dd></div>
                <div class="flex justify-between"><dt>Delivery</dt><dd class="tabular-nums" data-checkout-target="shipping">-</dd></div>
                <div class="flex justify-between"><dt>Discount</dt><dd class="tabular-nums" data-checkout-target="discount">-</dd></div>
                <div class="flex justify-between border-t border-slate-100 pt-2 text-base font-black text-navy-950"><dt>Total</dt><dd class="tabular-nums" data-checkout-target="total">-</dd></div>
            </dl>
            <p class="form-errors !mb-0 mt-3" role="status" data-checkout-target="messages"></p>
        </aside>
    </div>
{% endblock %}
